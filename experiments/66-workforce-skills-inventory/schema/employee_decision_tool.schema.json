{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Employee confirms, rejects, or corrects one skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "decision", "inventory_id", "inventory_hash", "skill_id", "skill_hash", "approver_ref"],
  "properties": {
    "item": {"type": "string", "const": "skill"},
    "decision": {"type": "string", "enum": ["confirm", "reject", "correct"]},
    "inventory_id": {"type": "string"},
    "inventory_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "skill_id": {"type": "string"},
    "skill_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "approver_ref": {"type": "string", "pattern": "^EMP-\\d{4}$"},
    "correction": {"type": "string", "maxLength": 500},
    "correction_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "wrote_to_hr_system": {"type": "boolean", "const": false}
  }
}
