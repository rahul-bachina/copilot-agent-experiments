{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Propose skills from employee-supplied evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "employee_ref", "purpose", "as_of"],
  "properties": {
    "synthetic": {"type": "boolean", "const": true},
    "employee_ref": {"type": "string", "pattern": "^EMP-\\d{4}$"},
    "purpose": {"type": "string", "const": "skills_inventory"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "team_view": {"type": "boolean"},
    "ask_learning_plan": {"type": "boolean"},
    "ask_mobility": {"type": "boolean"}
  }
}
