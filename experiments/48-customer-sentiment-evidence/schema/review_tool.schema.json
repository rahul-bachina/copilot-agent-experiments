{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review_tool.schema.json",
  "title": "Customer sentiment evidence review",
  "description": "Input for record_review(). The analyst confirms the sample frame and the limitations, or rejects the pack. The tool does not publish and does not contact a customer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "actor_role", "actor_id", "batch_id", "draft_checksum"],
  "properties": {
    "decision": {
      "enum": ["confirm_sample_frame_and_limitations", "reject_pack"]
    },
    "actor_role": {"const": "Analyst"},
    "actor_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "draft_checksum": {"type": "string"},
    "sample_frame_confirmed": {"type": "boolean"},
    "limitations_read": {"type": "boolean"},
    "sources_acknowledged": {"type": "boolean"},
    "open_period_acknowledged": {"type": "boolean"}
  }
}
