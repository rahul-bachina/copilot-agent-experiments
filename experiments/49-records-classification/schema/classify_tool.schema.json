{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "classify_tool.schema.json",
  "title": "Records classification tool",
  "description": "Read one synthetic document and return a draft classification. The tool does not delete, does not dispose, does not move, and does not downgrade a record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "text", "as_of"],
  "properties": {
    "synthetic": {"const": true},
    "document_id": {"type": "string"},
    "filename": {"type": "string"},
    "jurisdiction": {
      "enum": ["england", "wales", "scotland", "northern_ireland", "unspecified"]
    },
    "document_date": {"type": "string"},
    "existing_marking": {
      "enum": ["OFFICIAL", "OFFICIAL-SENSITIVE", "SECRET", "TOP SECRET"]
    },
    "text": {"type": "string"},
    "as_of": {"type": "string"}
  }
}
