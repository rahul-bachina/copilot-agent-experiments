{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "find_tool.schema.json",
  "title": "OneDrive find tool",
  "description": "Rank files inside locations the user has already confirmed. The tool does not search outside that selection, does not widen access, does not move, delete, share, or change permissions, and does not call Microsoft Graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "index_id", "query", "selection", "as_of"],
  "properties": {
    "synthetic": {"const": true},
    "index_id": {"type": "string"},
    "query": {"type": "string", "maxLength": 500},
    "as_of": {"type": "string"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "actor_role", "location_ids", "principals", "clearance"],
      "properties": {
        "confirmed": {"const": true},
        "actor_role": {"const": "Requesting user"},
        "actor_id": {"type": "string"},
        "location_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^LOC-[A-Z0-9-]{1,24}$"}
        },
        "principals": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^SYN-PRIN-[A-Z0-9-]{1,24}$"}
        },
        "clearance": {"enum": ["OFFICIAL", "OFFICIAL-SENSITIVE", "SECRET", "TOP SECRET"]}
      }
    }
  }
}
