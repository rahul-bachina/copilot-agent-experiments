    {
      "id": "wtr-reg-13",
      "pin": "Working Time Regulations 1998, regulation 13(1)",
      "url": "https://www.legislation.gov.uk/uksi/1998/1833/regulation/13",
      "text": "Subject to paragraph (5), a worker is entitled to four weeks' annual leave in each leave year.",
      "extent": "E+W+S",
      "note": "Regulation 13 applies to a worker in respect of any leave years beginning before 1st April 2024, and to a worker to whom regulation 15B does not apply in respect of any leave years beginning on or after 1st April 2024. Regulation 13A(A1) is in the same terms. Regulation 15B was not opened.",
      "opened": "2026-11-16",
      "point_in_time_text_verified": true,
      "individual_entitlement": false
    },
    {
      "id": "wtr-reg-13a",
      "pin": "Working Time Regulations 1998, regulation 13A(2)(e) and (3)",
      "url": "https://www.legislation.gov.uk/uksi/1998/1833/regulation/13A",
      "text": "in any leave year beginning on or after 1st April 2009, 1.6 weeks. The aggregate entitlement provided for in paragraph (2) and regulation 13(1) is subject to a maximum of 28 days.",
      "extent": "E+W+S",
      "note": "The GOV.UK holiday-entitlement page states that almost all people classed as workers are legally entitled to 5.6 weeks' paid holiday a year, that most workers who work a 5-day week must receive at least 28 days' paid annual leave, and that statutory paid holiday is limited to 28 days. It also states that an employer can include bank holidays as part of statutory annual leave, and that bank or public holidays do not have to be given as paid leave. That page is a summary. The four-weeks and 1.6-weeks figures are the regulations.",
      "govuk_url": "https://www.gov.uk/holiday-entitlement-rights",
      "opened": "2026-11-16",
      "point_in_time_text_verified": true,
      "individual_entitlement": false
    }
