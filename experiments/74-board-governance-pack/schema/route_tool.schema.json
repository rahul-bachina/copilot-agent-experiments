{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Record that the company secretary has seen a route",
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "decision", "approver_ref", "meeting_id", "content_hash"],
  "properties": {
    "item": {"const": "route-seen"},
    "decision": {"const": "seen"},
    "approver_ref": {"type": "string"},
    "meeting_id": {"type": "string"},
    "content_hash": {"type": "string"}
  }
}
