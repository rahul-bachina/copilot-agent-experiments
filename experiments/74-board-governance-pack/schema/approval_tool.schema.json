{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Approve a board-pack hash",
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "decision", "approver_ref", "meeting_id", "content_hash", "pins_seen"],
  "properties": {
    "item": {"const": "board-pack"},
    "decision": {"const": "approve-draft"},
    "approver_ref": {"type": "string"},
    "meeting_id": {"type": "string"},
    "content_hash": {"type": "string"},
    "pins_seen": {"const": true},
    "sources_seen": {"const": true},
    "dates_seen": {"const": true}
  }
}
