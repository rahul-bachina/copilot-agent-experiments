{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Draft a regulatory change briefing",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "publication_id", "caller_ref", "as_of"],
  "properties": {
    "synthetic": {"const": true},
    "publication_id": {"type": "string", "maxLength": 80},
    "caller_ref": {"type": "string"},
    "as_of": {"type": "string"},
    "pasted_text": {"type": "string"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marking": {"type": "string"},
        "retention": {"type": "array", "items": {"type": "string"}},
        "legal_hold": {"type": "boolean"}
      }
    }
  }
}
