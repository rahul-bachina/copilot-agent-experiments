{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Statutory clock tool input",
  "description": "Least-privilege input for the Awaab's Law clock. The tool returns JSON. It does not send, write, or approve.",
  "type": "object",
  "additionalProperties": false,
  "required": ["aware_at", "hazard_family", "category"],
  "properties": {
    "aware_at": {
      "type": "string",
      "description": "ISO-8601 awareness time with a timezone, entered by an officer."
    },
    "hazard_family": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["emergency", "significant", "not_in_scope", "uncertain"]
    },
    "social_home_in_england": {
      "type": "boolean"
    },
    "officer_approved_category": {
      "type": "boolean"
    },
    "officer_approved_clock": {
      "type": "boolean"
    },
    "investigation_completed_on": {
      "type": "string"
    },
    "investigation_completed_at": {
      "type": "string"
    },
    "physical_inspection_requested_on": {
      "type": "string"
    },
    "investigation_kind": {
      "type": "string",
      "enum": ["standard", "renewed"]
    },
    "emergency_condition": {
      "type": "string",
      "enum": ["1", "2"]
    },
    "part_6_complied": {
      "type": "boolean"
    },
    "supplementary_preventative_work_identified": {
      "type": "boolean"
    },
    "further_investigation_completed_on": {
      "type": "string"
    },
    "not_reasonably_practicable_to_begin": {
      "type": "boolean"
    },
    "caller_asserts_phase_2_instrument_in_force": {
      "type": "boolean"
    },
    "as_of": {
      "type": "string"
    }
  }
}
