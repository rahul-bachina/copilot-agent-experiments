{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Record that HR has seen an eligibility note",
  "type": "object",
  "additionalProperties": false,
  "required": ["approver_ref", "exploration_id", "content_hash", "decision", "item", "eligibility_decided", "interest_shared_with_manager"],
  "properties": {
    "approver_ref": {"type": "string", "pattern": "^EMP-\\d{4}$"},
    "exploration_id": {"type": "string"},
    "content_hash": {"type": "string"},
    "decision": {"type": "string", "const": "seen"},
    "item": {"type": "string", "const": "eligibility-note"},
    "eligibility_decided": {"type": "boolean", "const": false},
    "interest_shared_with_manager": {"type": "boolean", "const": false},
    "applied": {"type": "boolean", "const": false},
    "shortlisted": {"type": "boolean", "const": false},
    "contacted": {"type": "boolean", "const": false}
  }
}
