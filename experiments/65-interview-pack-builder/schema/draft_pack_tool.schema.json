{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Draft interview pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "guide", "directory", "as_of"],
  "properties": {
    "request": {"type": "object"},
    "guide": {"type": "object"},
    "directory": {"type": "object"},
    "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
