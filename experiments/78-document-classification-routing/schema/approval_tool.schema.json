{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Confirm a class and a destination for the held hash",
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "decision", "approver_ref", "document_id", "content_hash", "class_id", "destination_queue", "pins_seen"],
  "properties": {
    "item": {"const": "routing"},
    "decision": {"const": "confirm-routing"},
    "approver_ref": {"type": "string"},
    "document_id": {"type": "string"},
    "content_hash": {"type": "string"},
    "class_id": {"type": ["string", "null"]},
    "destination_queue": {"type": "string"},
    "pins_seen": {"const": true},
    "sources_seen": {"const": true},
    "dates_seen": {"const": true},
    "clocks_seen": {"const": true},
    "marking_seen": {"const": true},
    "hold_seen": {"const": true},
    "suppression_seen": {"const": true}
  }
}
