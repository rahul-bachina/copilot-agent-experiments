{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Record that the advice hash was seen",
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "decision", "approver_ref", "advice_hash", "pins_seen"],
  "properties": {
    "item": {"type": "string", "const": "retention-advice-seen"},
    "decision": {"type": "string", "const": "seen"},
    "approver_ref": {"type": "string", "minLength": 1, "maxLength": 40},
    "advice_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pins_seen": {"type": "boolean", "const": true},
    "schedule_seen": {"type": "boolean"},
    "sources_seen": {"type": "boolean"},
    "route_seen": {"type": "boolean"}
  }
}
