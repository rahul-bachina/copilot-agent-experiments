{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Explain retention advice",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "series_id", "as_of"],
  "properties": {
    "synthetic": {"type": "boolean", "const": true},
    "series_id": {"type": "string", "minLength": 1, "maxLength": 40},
    "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "caller_ref": {"type": "string", "maxLength": 40},
    "title": {"type": "string", "maxLength": 200},
    "content": {"type": "string", "maxLength": 20000},
    "protective_marking": {"type": "string", "maxLength": 40}
  }
}
