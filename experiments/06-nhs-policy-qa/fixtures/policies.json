        {
          "clause_id": "4.2",
          "heading": "Notice to book annual leave",
          "text": "Staff book annual leave of one week or more with at least 10 working days' notice. Shorter notice is for the line manager to consider. This clause does not calculate any person's remaining balance.",
          "match_phrases": ["notice to book annual leave", "book annual leave", "10 working days' notice", "how much notice"]
        },
        {
          "clause_id": "5.1",
          "heading": "Allowance written in this policy",
          "text": "Full-time staff on the Northmere corporate contract have 27 days of annual leave a year plus bank holidays, as written in this policy. Part-time staff have the pro-rata figure in their contract. This clause does not calculate a balance.",
          "match_phrases": ["annual leave allowance", "how many days of annual leave", "27 days"]
        }
      ]
    },
