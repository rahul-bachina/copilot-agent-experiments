{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "create_tool.schema.json",
  "title": "Approved task stub tool",
  "description": "Record JSON stubs for task ids the content owner has already approved through record_approval. Planner and Power Automate are not called. Pages are not edited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["via", "decision", "actor_role", "inventory_id", "task_ids"],
  "properties": {
    "via": {"const": "record_approval"},
    "decision": {"const": "approve_tasks"},
    "actor_role": {"const": "Content owner"},
    "actor_id": {"type": "string", "pattern": "^SYN-OWNER-[A-Z0-9-]{1,24}$"},
    "inventory_id": {"type": "string", "pattern": "^SYN-INV-\\d{4}$"},
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^TASK-\\d{4}$"}
    }
  }
}
