          },
          {
            "id": "inventory",
            "kind": "ordinary",
            "text": "Inventory one synthetic document batch and the files supplied.",
            "expected": "skill:inventory-documents"
          },
          {
            "id": "hazard",
            "kind": "ordinary",
            "text": "Review one hazard report and the statutory clock for a housing officer.",
