{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "confirm_tool.schema.json",
  "title": "Scope confirmation tool",
  "description": "A separate confirmation that the model owner has seen the workbook, the ranges, and the formulas. It does not edit the workbook and it does not accept the findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "actor_role",
    "actor_id",
    "model_id",
    "formulas_in_scope_acknowledged",
    "protective_marking_seen",
    "workbook_fingerprint",
    "ranges"
  ],
  "properties": {
    "decision": {"const": "confirm_workbook_ranges_and_formulas"},
    "actor_role": {"const": "model_owner"},
    "actor_id": {"type": "string", "pattern": "^SYN-OWN-\\d{3}$"},
    "model_id": {"type": "string", "pattern": "^SYN-MDL-\\d{4}$"},
    "formulas_in_scope_acknowledged": {"const": true},
    "protective_marking_seen": {"const": true},
    "workbook_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ranges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*![A-Z]{1,3}[0-9]+(?::[A-Z]{1,3}[0-9]+)?$"}
    }
  }
}
