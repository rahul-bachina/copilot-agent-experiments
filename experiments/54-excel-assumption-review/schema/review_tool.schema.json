{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review_tool.schema.json",
  "title": "Workbook review tool",
  "description": "Input for review_workbook() together with a separate confirmation. The tool reads confirmed cells. It does not edit the workbook, judge an assumption, or invent a benchmark.",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "model_id", "cells"],
  "properties": {
    "synthetic": {"const": true},
    "model_id": {"type": "string", "pattern": "^SYN-MDL-\\d{4}$"},
    "organisation": {"type": "string", "maxLength": 200},
    "protective_marking": {"type": "string", "maxLength": 80},
    "retention_label": {"type": "string", "maxLength": 80},
    "workbook_xlsx": {"type": "string", "maxLength": 200},
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sheet", "cell", "value"],
        "properties": {
          "sheet": {"type": "string", "maxLength": 80},
          "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]+$"},
          "value": {"type": "string", "maxLength": 2000},
          "formula": {"type": ["string", "null"], "maxLength": 500},
          "assumption_id": {"type": "string", "maxLength": 80},
          "unit": {"type": "string", "maxLength": 40},
          "date_basis": {"type": "string", "maxLength": 40},
          "label": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}
