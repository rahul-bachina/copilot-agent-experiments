{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Record one approval of one learning plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "approver_ref", "decision", "item"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^LP-[0-9a-f]{12}$"},
    "approver_ref": {"type": "string", "pattern": "^EMP-\\d{4}$"},
    "decision": {"type": "string", "const": "approve"},
    "item": {"type": "string", "const": "learning-plan"},
    "stale_seen": {"type": "boolean"},
    "budget_unreadable_seen": {"type": "boolean"},
    "enrolled": {"type": "boolean", "const": false},
    "booked": {"type": "boolean", "const": false},
    "spent_gbp": {"type": "null"}
  }
}
