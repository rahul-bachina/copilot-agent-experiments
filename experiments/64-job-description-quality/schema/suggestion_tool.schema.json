{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Record one recruiter decision on one suggestion",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft_hash", "suggestion_id", "suggestion_hash", "approver_ref", "decision", "item"],
  "properties": {
    "draft_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "suggestion_id": {"type": "string", "pattern": "^F-\\d{2}$"},
    "suggestion_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approver_ref": {"type": "string", "pattern": "^REC-\\d{4}$"},
    "decision": {"type": "string", "enum": ["accept", "reject"]},
    "item": {"type": "string", "const": "suggestion"}
  }
}
