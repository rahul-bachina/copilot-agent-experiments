{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review one synthetic job description",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "recruiter_ref", "as_of"],
  "properties": {
    "synthetic": {"type": "boolean", "const": true},
    "recruiter_ref": {"type": "string", "pattern": "^REC-\\d{4}$"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "question_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
