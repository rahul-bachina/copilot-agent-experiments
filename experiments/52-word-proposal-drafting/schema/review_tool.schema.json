{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review_tool.schema.json",
  "title": "Author acceptance tool",
  "description": "Input for record_acceptance(). The author accepts, asks for a revision, or rejects. Acceptance does not submit the draft and the schema has no recipient.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "actor_role", "actor_id", "proposal_id", "complete_draft_seen", "rows_acknowledged"],
  "properties": {
    "decision": {
      "enum": [
        "author_accept_complete_draft",
        "author_request_revision",
        "reject_draft"
      ]
    },
    "actor_role": {"const": "author"},
    "actor_id": {"type": "string", "pattern": "^SYN-AUTH-\\d{3}$"},
    "proposal_id": {"type": "string", "pattern": "^SYN-BID-\\d{4}$"},
    "complete_draft_seen": {"type": "boolean"},
    "rows_acknowledged": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 12
    },
    "author_checks_seen": {"type": "boolean"},
    "gaps_seen": {"type": "boolean"}
  }
}
