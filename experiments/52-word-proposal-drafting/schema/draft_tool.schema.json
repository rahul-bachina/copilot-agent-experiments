{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "draft_tool.schema.json",
  "title": "Proposal draft tool",
  "description": "Input for draft_proposal(). The tool reads one synthetic invitation and an approved library. It does not submit, send, or upload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "proposal_id", "requirements"],
  "properties": {
    "synthetic": {"const": true},
    "proposal_id": {"type": "string", "pattern": "^SYN-BID-\\d{4}$"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]{1,2}$"},
          "text": {"type": "string", "maxLength": 2000}
        }
      }
    }
  }
}
